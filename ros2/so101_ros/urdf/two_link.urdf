<?xml version="1.0"?>
<robot name="two_link">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry><box size="0.1 0.1 0.05"/></geometry>        <!-- a flat slab, e.g. 10 cm × 10 cm × 5 cm -->
    </visual>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>                  <!-- half the stick's length, so it starts at the joint -->
      <geometry><box size="0.02 0.02 0.1"/></geometry>        <!-- a thin tall stick -->
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>                    <!-- the top surface of the slab -->
    <axis xyz="1 0 0"/>                              <!-- pick an axis that swings the stick sideways -->
    <limit lower="0.0" upper="0.5" effort="1.0" velocity="1.0"/>  <!-- radians; effort + velocity REQUIRED -->
  </joint>

</robot>
